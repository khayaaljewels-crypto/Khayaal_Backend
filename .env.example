# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Local dev — create a dedicated database + user first, e.g. in psql:
#   CREATE DATABASE khayaal;
#   CREATE USER khayaal_app WITH PASSWORD 'change-me';
#   GRANT ALL PRIVILEGES ON DATABASE khayaal TO khayaal_app;
#
# Neon (production) — copy the connection string from the Neon dashboard.
# It already includes `?sslmode=require`, which `pg` reads automatically —
# no extra SSL config is needed in code for that to work.
#   postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
DATABASE_URL=postgresql://khayaal_app:change-me@localhost:5432/khayaal

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth credentials from Google Cloud Console → APIs & Services → Credentials
# (NOT Firebase — this is a separate Google Cloud OAuth Client ID/Secret)
# In production, GOOGLE_CALLBACK_URL must be this backend's actual deployed URL
# (e.g. https://your-backend-host.example.com/auth/google/callback), and that same
# URL must be added to "Authorized redirect URIs" on the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where the frontend runs — used for CORS and for redirecting after login.
# In production this must be the deployed Vercel URL, e.g. https://khayaal-jewels.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional second allowed CORS origin (e.g. an http:// variant, a Vercel
# preview URL, or a custom domain alongside the default *.vercel.app one).
# See allowedOrigins in src/index.js.
FRONTEND_URL_HTTP=

# Port this backend listens on. Most hosting platforms set this automatically
# at runtime — process.env.PORT already takes precedence, so nothing to change there.
PORT=4000

# Set to "production" on your hosting platform. This also flips auth cookies to
# secure + sameSite=none (required whenever the frontend and backend are on
# different domains — see src/middleware/auth.js) — do not deploy with this unset.
NODE_ENV=development

# No longer used by any route — every /api/admin/* route (including
# customers) is now protected by ADMIN_EMAIL/Firebase below. Safe to leave
# unset; kept here only so old deployments setting it don't break.
ADMIN_API_KEY=

# The one email allowed to act as admin — must exactly match the frontend's
# VITE_ADMIN_EMAIL (the same Firebase user that logs into /admin there).
# requireAdmin (src/middleware/requireAdmin.js) verifies the caller's real
# Firebase ID token and checks its email against this value.
ADMIN_EMAIL=

# Firebase service-account key JSON, as a single-line string, used by
# requireAdmin to verify admin ID tokens server-side. Generate one at
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key, for the SAME Firebase project the admin dashboard already
# logs into (VITE_FIREBASE_* in the frontend's .env). Paste the whole JSON
# file's contents on one line, e.g.:
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
# Keep this secret — it grants full admin access to that Firebase project.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Image storage driver — "local" (default, disk under uploads/, not
# persistent across most hosting platforms) or "cloudinary" (production).
# See src/services/storage/index.js for the driver registry.
STORAGE_DRIVER=cloudinary

# Cloudinary account credentials (cloudinary.com → Dashboard). Used by
# src/services/storage/cloudinaryDriver.js for all product/category/
# collection image uploads, and by the one-time import (POST
# /api/admin/import) to rehost already-existing image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
