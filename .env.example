# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# For local dev, create a dedicated database + user first, e.g. in psql:
#   CREATE DATABASE khayaal;
#   CREATE USER khayaal_app WITH PASSWORD 'change-me';
#   GRANT ALL PRIVILEGES ON DATABASE khayaal TO khayaal_app;
DATABASE_URL=postgresql://khayaal_app:change-me@localhost:5432/khayaal

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth credentials from Google Cloud Console → APIs & Services → Credentials
# (NOT Firebase — this is a separate Google Cloud OAuth Client ID/Secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where the frontend runs — used for CORS and for redirecting after login
FRONTEND_URL=http://localhost:5173

# Port this backend listens on
PORT=4000

# Set to "production" to enable secure (HTTPS-only) cookies
NODE_ENV=development

# INTERIM ONLY: gates the /api/admin/customers routes for local testing
# (curl/Postman), since real Firebase-Admin-SDK verification isn't wired up
# yet. Never put this key in any frontend code. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
